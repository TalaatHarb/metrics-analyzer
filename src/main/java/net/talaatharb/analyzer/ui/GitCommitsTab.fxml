<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml">
    <padding>
        <Insets top="10.0" right="10.0" bottom="10.0" left="10.0" />
    </padding>
    <top>
        <HBox spacing="10.0" alignment="CENTER_LEFT" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="0.0" right="0.0" bottom="10.0" left="0.0" />
            </padding>
            <children>
                <Label fx:id="currentBranchLabel" text="Current Branch: None" style="-fx-font-weight: bold;" />
                <Label text="  |  Switch to:" />
                <ComboBox fx:id="branchComboBox" />
                <Button fx:id="switchButton" text="Switch Branch" />
                <Button fx:id="refreshButton" text="Refresh" />
                <Button fx:id="diffButton" text="Diff" />
            </children>
        </HBox>
    </top>
    <center>
        <VBox>
            <children>
                <ListView fx:id="commitListView" VBox.vgrow="ALWAYS" />
                <Button fx:id="loadMoreButton" text="Load More Commits" maxWidth="1.7976931348623157E308" />
            </children>
        </VBox>
    </center>
    <bottom>
        <Label text="Double-click a commit to view its diff, or use Diff for working tree changes." BorderPane.alignment="CENTER_LEFT">
            <padding>
                <Insets top="5.0" right="0.0" bottom="0.0" left="0.0" />
            </padding>
        </Label>
    </bottom>
</BorderPane>
